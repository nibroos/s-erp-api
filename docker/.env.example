# .env
APP_HOST=http://localhost:4001 ## http://192.168.1.2:4001

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=s_erp_api
POSTGRES_DB_TEST=tests_s_erp_api
POSTGRES_PORT=5432
POSTGRES_HOST=postgres # or localhost

# Service Ports
GATEWAY_PORT=4050
SERVICE_GRPC_PORT=50051
SERVICE_REST_PORT=4001

# REDIS Configuration
REDIS_HOST=redis # or localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB=0

# PostgreSQL Configuration for Test
POSTGRES_USER_TEST=postgres
POSTGRES_PASSWORD_TEST=secret
POSTGRES_DB_TEST=tests_s_erp_api
POSTGRES_PORT_TEST=5433
POSTGRES_HOST_TEST=postgres-s-erp-api-test # or postgres

# REDIS Configuration for Test
REDIS_HOST_TEST=redis-s-erp-api-test # or localhost
REDIS_PORT_TEST=6380
REDIS_PASSWORD_TEST=secret
REDIS_DB_TEST=1

# JWT Configuration
JWT_SECRET=nibrossecret
JWT_EXPIRES_MINUTE_AT=10800
DEFAULT_BRANCH_ID=1

RABBITMQ_USER=yubi
RABBITMQ_PASSWORD=yubi9911
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

schedule_credentials=admin
schedule_password=admin

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL_USER=test@gmail.com
# SMTP_EMAIL_PASSWORD=secret

SMTP_HOST=mail.yubiteck.com
SMTP_PORT=465
SMTP_EMAIL_USER=developer@yubiteck.com
SMTP_EMAIL_PASSWORD=secret

# MinIO (chat attachments)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=chat-attachments
MINIO_USE_SSL=false

# AI assistant (chat)
# Provider: "local" (OpenAI-compatible GPU endpoint, default), "remote"
# (hosted OpenAI-compatible endpoint with local as fallback), or "claude".
AI_PROVIDER=local
# Ollama, reached by container name over the shared `localai_default` network
# (see localai-network in docker-compose-dev.yml). Ollama serves an
# OpenAI-compatible API under /v1.
# host override (running on the host): http://localhost:11434/v1
AI_LOCAL_BASE_URL=http://ollama:11434/v1
AI_LOCAL_MODEL=qwen2.5:7b-instruct-q4_K_M
# Separate vision model, used only for messages with an image attached. The
# text model above cannot see images. Leave empty to disable image reading.
AI_LOCAL_VISION_MODEL=qwen2.5vl:7b
AI_LOCAL_API_KEY=
# Hosted option (used when AI_PROVIDER=remote): your self-hosted endpoint.
# Models are tried in order — first is primary, the rest are same-endpoint
# fallbacks. When every hosted model fails, the local provider above takes
# over as the final fallback.
AI_REMOTE_BASE_URL=https://ai.nibros.space/v1
AI_REMOTE_MODEL=ai/gpt-5.6-luna,bbai
AI_REMOTE_API_KEY=
AI_REMOTE_VISION_MODEL=bbai-img-1
# AI_REMOTE_TEMPERATURE=0.2
# Claude option (used only when AI_PROVIDER=claude):
# ANTHROPIC_API_KEY=
# AI_CLAUDE_MODEL=claude-opus-4-8

AUTH_SERVICE_URL=http://auth:4020
CHAT_AI_QUEUE=true