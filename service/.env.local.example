# Host-run overrides — copy to `.env.local` when you run the Go service or
# tests directly on your machine (outside Docker). Loaded BEFORE .env, and
# godotenv never overrides already-set keys, so these win locally while the
# canonical docker/.env (symlinked as ./.env) stays the container default.
#
# Set ONLY the vars that differ on the host — container hostnames are not
# reachable from outside the docker network.

POSTGRES_HOST=localhost
REDIS_HOST=localhost

# Test stack, if you run `go test` against the published test container ports:
POSTGRES_HOST_TEST=localhost
REDIS_HOST_TEST=localhost

# Local Ollama endpoint as seen from the host (the container name `ollama`
# only resolves inside the docker network):
AI_LOCAL_BASE_URL=http://localhost:11434/v1
